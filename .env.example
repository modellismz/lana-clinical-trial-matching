# Static demo and metric replay need no environment variables or API credentials.
# Optional local IRIS prototype pipeline; export these in your own shell.
# The inherited prototype uses its community-image local development defaults.
LANA_IRIS_HOST=127.0.0.1
LANA_IRIS_PORT=1974
LANA_IRIS_NAMESPACE=USER
LANA_IRIS_USER=_SYSTEM
LANA_IRIS_PASSWORD=
# External API credentials, if used for a separate experiment, stay outside Git.
